# Manual target additions for nightly builds
# This content will be appended to the auto-generated targets-release-nightly.yaml

# Ubuntu minimal cloud
minimal-cli-stable-ubuntu-cloud:
  enabled: yes
  configs: [ armbian-cloud ]
  pipeline:
    gha: *armbian-gha
  build-image: "yes"
  vars:
    RELEASE: UBUNTU
    BUILD_MINIMAL: "yes"
    BUILD_DESKTOP: "no"
  items:
    - { BOARD: uefi-arm64, BRANCH: cloud, ENABLE_EXTENSIONS: "image-output-iso" }
    - { BOARD: uefi-x86, BRANCH: cloud, ENABLE_EXTENSIONS: "image-output-iso" }
    - { BOARD: uefi-arm64, BRANCH: cloud, ENABLE_EXTENSIONS: "image-output-qcow2" }
    - { BOARD: uefi-x86, BRANCH: cloud, ENABLE_EXTENSIONS: "image-output-qcow2" }
    - { BOARD: uefi-arm64, BRANCH: cloud, ENABLE_EXTENSIONS: "image-output-vhdx" }
    - { BOARD: uefi-x86, BRANCH: cloud, ENABLE_EXTENSIONS: "image-output-vhdx" }

# Debian minimal cloud
minimal-cli-stable-debian-cloud:
  enabled: yes
  configs: [ armbian-cloud ]
  pipeline:
    gha: *armbian-gha
  build-image: "yes"
  vars:
    RELEASE: DEBIAN
    BUILD_MINIMAL: "yes"
    BUILD_DESKTOP: "no"
  items:
    - { BOARD: uefi-arm64, BRANCH: cloud, ENABLE_EXTENSIONS: "image-output-iso" }
    - { BOARD: uefi-x86, BRANCH: cloud, ENABLE_EXTENSIONS: "image-output-iso" }
    - { BOARD: uefi-arm64, BRANCH: cloud, ENABLE_EXTENSIONS: "image-output-qcow2" }
    - { BOARD: uefi-x86, BRANCH: cloud, ENABLE_EXTENSIONS: "image-output-qcow2" }
    - { BOARD: uefi-arm64, BRANCH: cloud, ENABLE_EXTENSIONS: "image-output-vhdx" }
    - { BOARD: uefi-x86, BRANCH: cloud, ENABLE_EXTENSIONS: "image-output-vhdx" }

# Khadas VIM1S / VIM4 on mainline (edge).
# Both boards are in targets-release-nightly.blacklist, so the auto-generated
# section skips them. Explicit target: Ubuntu minimal CLI.
nightly-ubuntu-minimal-khadas-vims:
  enabled: yes
  configs: [ armbian-images ]
  pipeline:
    gha: *armbian-gha
  build-image: "yes"
  vars:
    RELEASE: UBUNTU
    BUILD_MINIMAL: "yes"
    BUILD_DESKTOP: "no"
  items:
    - { BOARD: khadas-vim1s, BRANCH: edge, ENABLE_EXTENSIONS: "image-output-oowow" }
    - { BOARD: khadas-vim4, BRANCH: edge, ENABLE_EXTENSIONS: "image-output-oowow" }

# Radxa ROCK 4D on mainline (edge), next to the auto-generated vendor nightly.
# Nightly picks only the first branch of KERNEL_TEST_TARGET ("vendor,edge"),
# so edge, which has the NPU since 7.3 (armbian/build#11163), is added here.
# Each target also builds a UFS (4K sector) image, like the stable release.
# See armbian/build#11263.
nightly-debian-minimal-rock-4d-edge:
  enabled: yes
  configs: [ armbian-images ]
  pipeline:
    gha: *armbian-gha
  build-image: "yes"
  vars:
    RELEASE: DEBIAN
    BUILD_MINIMAL: "yes"
    BUILD_DESKTOP: "no"
  items:
    - { BOARD: radxa-rock-4d, BRANCH: edge, ENABLE_EXTENSIONS: "v4l2loopback-dkms" }
    - { BOARD: radxa-rock-4d, BRANCH: edge, ENABLE_EXTENSIONS: "v4l2loopback-dkms,ufs" }

nightly-ubuntu-minimal-rock-4d-edge:
  enabled: yes
  configs: [ armbian-images ]
  pipeline:
    gha: *armbian-gha
  build-image: "yes"
  vars:
    RELEASE: UBUNTU
    BUILD_MINIMAL: "yes"
    BUILD_DESKTOP: "no"
  items:
    - { BOARD: radxa-rock-4d, BRANCH: edge, ENABLE_EXTENSIONS: "v4l2loopback-dkms" }
    - { BOARD: radxa-rock-4d, BRANCH: edge, ENABLE_EXTENSIONS: "v4l2loopback-dkms,ufs" }

# Debian forky Hyprland desktop for KVM (qcow2).
# Btrfs root with zstd, LUKS encrypted with automatic unlock.
desktop-debian-hyprland-cloud:
  enabled: yes
  configs: [ armbian-cloud ]
  pipeline:
    gha: *armbian-gha
  build-image: "yes"
  vars:
    RELEASE: forky
    BUILD_MINIMAL: "no"
    BUILD_DESKTOP: "yes"
    DESKTOP_ENVIRONMENT: "hyprland"
    DESKTOP_TIER: "minimal"
    ROOTFS_TYPE: "btrfs"
    BTRFS_COMPRESSION: "zstd"
    BOOTSIZE: "2048"
    CRYPTROOT_ENABLE: "yes"
    CRYPTROOT_AUTOUNLOCK: "yes"
    CRYPTROOT_SSH_UNLOCK: "no"
  items:
    - { BOARD: uefi-x86, BRANCH: cloud, ENABLE_EXTENSIONS: "image-output-qcow2" }
    - { BOARD: uefi-arm64, BRANCH: cloud, ENABLE_EXTENSIONS: "image-output-qcow2" }

# Ubuntu GNOME desktop for KVM (qcow2).
# Btrfs root with zstd, LUKS encrypted with automatic unlock.
desktop-ubuntu-gnome-cloud:
  enabled: yes
  configs: [ armbian-cloud ]
  pipeline:
    gha: *armbian-gha
  build-image: "yes"
  vars:
    RELEASE: UBUNTU
    BUILD_MINIMAL: "no"
    BUILD_DESKTOP: "yes"
    DESKTOP_ENVIRONMENT: "gnome"
    DESKTOP_TIER: "minimal"
    ROOTFS_TYPE: "btrfs"
    BTRFS_COMPRESSION: "zstd"
    BOOTSIZE: "2048"
    CRYPTROOT_ENABLE: "yes"
    CRYPTROOT_AUTOUNLOCK: "yes"
    CRYPTROOT_SSH_UNLOCK: "no"
  items:
    - { BOARD: uefi-x86, BRANCH: cloud, ENABLE_EXTENSIONS: "image-output-qcow2" }
    - { BOARD: uefi-arm64, BRANCH: cloud, ENABLE_EXTENSIONS: "image-output-qcow2" }
