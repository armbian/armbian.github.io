xiaomi-elish
beaglebadge
pocketbeagle2
# The generic UEFI virtual targets are distributed as installable .iso images,
# not raw board images. The apps auto-section can't set image-output-iso (it
# emits boards without per-board extensions), so these two are excluded here
# and re-added as .iso app targets in targets-release-apps.manual.
uefi-x86
uefi-arm64

# Superseded by the unified "friendlyelec-rk3588" image (armbian/build#10946),
# which covers these boards plus M6V2/T6-LTS-Plus via runtime SARADC
# detection. Their .conf files stay unchanged/independent in armbian/build;
# this only stops new builds under their old slugs across all target types.
nanopi-r6s
nanopi-r6c
nanopi-m6
nanopct6
nanopct6-lts
